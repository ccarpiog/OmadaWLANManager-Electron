{
  "description": "Token endpoint results (POST /openapi/authorize/token?grant_type=client_credentials) for validateTokenResult() in src/main/openapi-client.ts. Shape per TP-Link's Open API guide (docs/omada-6.3-api-findings.md); not live-verified (D4). renewAt = nowMs + lifetime - min(60 s, lifetime / 2).",
  "success": {
    "errorCode": 0,
    "msg": "Open API Get Access Token successfully.",
    "result": {
      "accessToken": "AT-fixture-0001",
      "tokenType": "bearer",
      "expiresIn": 7200,
      "refreshToken": "RT-fixture-0001"
    }
  },
  "valid": [
    {
      "name": "documented shape: 7200 s lifetime, renewed 60 s early",
      "nowMs": 1000000,
      "result": { "accessToken": "AT-fixture-0001", "tokenType": "bearer", "expiresIn": 7200, "refreshToken": "RT-fixture-0001" },
      "expected": { "accessToken": "AT-fixture-0001", "renewAt": 8140000 }
    },
    {
      "name": "no expiresIn: the 300 s default lifetime",
      "nowMs": 0,
      "result": { "accessToken": "AT-x" },
      "expected": { "accessToken": "AT-x", "renewAt": 240000 }
    },
    {
      "name": "a short lifetime is renewed at half of it",
      "nowMs": 0,
      "result": { "accessToken": "AT-y", "expiresIn": 30 },
      "expected": { "accessToken": "AT-y", "renewAt": 15000 }
    },
    {
      "name": "an absurd lifetime is clamped to one day",
      "nowMs": 0,
      "result": { "accessToken": "AT-z", "expiresIn": 99999999 },
      "expected": { "accessToken": "AT-z", "renewAt": 86340000 }
    }
  ],
  "invalid": [
    { "name": "no result" },
    { "name": "result is a string", "result": "AT-1" },
    { "name": "no accessToken", "result": { "expiresIn": 7200 } },
    { "name": "empty accessToken", "result": { "accessToken": "", "expiresIn": 7200 } },
    { "name": "numeric accessToken", "result": { "accessToken": 12345, "expiresIn": 7200 } },
    { "name": "accessToken with a space", "result": { "accessToken": "AT 1", "expiresIn": 7200 } },
    { "name": "accessToken with a header injection", "result": { "accessToken": "AT-1\r\nX-Evil: 1", "expiresIn": 7200 } },
    { "name": "zero expiresIn", "result": { "accessToken": "AT-1", "expiresIn": 0 } },
    { "name": "negative expiresIn", "result": { "accessToken": "AT-1", "expiresIn": -5 } },
    { "name": "string expiresIn", "result": { "accessToken": "AT-1", "expiresIn": "7200" } }
  ]
}
