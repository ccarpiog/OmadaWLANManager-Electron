        "id": "6501c0ffee0000000000b004",
        "name": "Aulas",
        "primary": "true",
        "apNum": -1,
        "ssidNameList": ["Aulas", 5, null, "Profes"],
        "remainingBinding": { "0": 2, "1": -1, "2": 1.5, "mlo": "4" }
      },
      "expected": {
        "id": "6501c0ffee0000000000b004",
        "name": "Aulas",
        "ssidNameList": ["Aulas", "Profes"],
        "remainingBinding": { "0": 2 }
      }
    },
    {
      "name": "fractional apNum and a remainingBinding array are left out",
      "entry": { "id": "6501c0ffee0000000000b005", "name": "Patio", "apNum": 2.5, "ssidNameList": "Casa", "remainingBinding": [1, 2] },
      "expected": { "id": "6501c0ffee0000000000b005", "name": "Patio" }
    }
  ],
