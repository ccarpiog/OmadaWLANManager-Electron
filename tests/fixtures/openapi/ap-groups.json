      "expected": { "id": "6501c0ffee0000000000b002", "name": "zNinguna", "apNum": 0, "ssidNameList": [] }
    },
    {
      "name": "only the id: the name normalized, every optional field absent",
      "entry": { "id": "6501c0ffee0000000000b003" },
      "expected": { "id": "6501c0ffee0000000000b003", "name": "" }
    },
    {
      "name": "insane optional fields are dropped or filtered (primary not true, negative or fractional apNum, non-string SSID names, bad bindings)",
