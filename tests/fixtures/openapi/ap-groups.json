        "name": "Default",
        "isDefault": true,
        "apNum": 4,
        "ssidNameList": ["Casa", "Invitados"],
        "remainingBinding": { "0": 6, "1": 6, "2": 8 }
      }
    },
    {
      "name": "an empty group: no networks, 0 APs, not default",
